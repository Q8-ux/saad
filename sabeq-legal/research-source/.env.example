OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AUTH_SECRET=
RESEND_API_KEY=
AUTH_FROM_EMAIL=Sabeq Legal <noreply@sabeq.legal>

# Exact administrative email allowlist for the independent GitHub management client.
# Configure in server runtime settings; no customer credentials belong in this file.
MANAGEMENT_ALLOWED_EMAILS=
# Verified Site owner email, set separately to preserve the existing allowlist.
MANAGEMENT_OWNER_EMAIL=

# SADAD Kuwait server-only credentials. No public/VITE/NEXT_PUBLIC prefix.
SADAD_CLIENT_KEY=
SADAD_CLIENT_SECRET=
SADAD_ENVIRONMENT=sandbox

# Optional staged switch; enable only AFTER both accounts work.
# When enabled, ONLY administrator "saad" and operator "ahmad" may sign in.
# Rejects legacy email/SSO management sessions and every other account.
MANAGEMENT_LOGIN_MODE=
# The secure management account configuration itself belongs to hosting secrets:
# MANAGEMENT_ADMIN_PASSWORD_USERS, MANAGEMENT_ADMIN_PASSWORD_PEPPER
# MANAGEMENT_PASSWORD_USERS (if using seeded operator), MANAGEMENT_PASSWORD_PEPPER
# Never commit passwords, salts, hashes, session tokens or peppers.
