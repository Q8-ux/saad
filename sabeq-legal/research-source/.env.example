OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Text generation provider (openai, gemini, meta, groq, nvidia, openrouter, heretic); files and audio retain their existing provider.
LEGAL_AI_PROVIDER=openai
LEGAL_AI_FALLBACK_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Meta Model API (server-side only; standard non-training models only — -contributor models are blocked).
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional private GGUF server. Keep LEGAL_AI_PROVIDER=openai in production until reviewed.
# Heretic requires authenticated HTTPS on /v1/chat/completions; secrets only in server runtime.
HERETIC_CHAT_COMPLETIONS_URL=
HERETIC_API_KEY=
HERETIC_MODEL=
AUTH_SECRET=
RESEND_API_KEY=
AUTH_FROM_EMAIL=Sabeq Legal <noreply@sabeq.legal>

# Exact administrative email allowlist for the independent GitHub management client.
# Configure in server runtime settings; no customer credentials belong in this file.
MANAGEMENT_ALLOWED_EMAILS=
# Verified Site owner email, set separately to preserve the existing allowlist.
MANAGEMENT_OWNER_EMAIL=

# SADAD Kuwait server-only credentials. No public/VITE/NEXT_PUBLIC prefix.
SADAD_CLIENT_KEY=
SADAD_CLIENT_SECRET=
SADAD_ENVIRONMENT=sandbox

# Gmail sender/reviewers are configured as protected runtime values.
GMAIL_SENDER_EMAIL=drafts@example.test
MEMO_REVIEW_RECIPIENTS=review.one@example.test,review.two@example.test
