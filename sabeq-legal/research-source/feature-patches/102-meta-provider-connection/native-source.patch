diff --git a/tests/openrouter-errors.test.mjs b/tests/openrouter-errors.test.mjs
new file mode 100644
index 0000000..6143242
--- /dev/null
+++ b/tests/openrouter-errors.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { load } from './template-harness.mjs';
+const { compatibleTextResponse, textProviderConfig } = load('../lib/text-providers.ts');
+const router = textProviderConfig({ OPENROUTER_API_KEY:'synthetic-private-router-key', OPENROUTER_MODEL:'meta-llama/llama-3.3-70b-instruct:free' }, 'openrouter');
+const request = { body:JSON.stringify({ instructions:'اختبار تقني اصطناعي', input:'لا توجد قضية فعلية', max_output_tokens:32 }) };
+
+test('OpenRouter rejection reasons distinguish privacy, availability, parameters and credit without exposing upstream content', async()=>{
+ for(const [status,message,reason,kind] of [
+  [404,'No endpoints found matching your data policy (Zero data retention).','data_policy','model_access'],
+  [404,'No endpoints found that support the requested parameters.','parameters','model_access'],
+  [404,'No endpoints found for this model.','unavailable','model_access'],
+  [404,'Model is not allowed by the API key guardrail.','access','model_access'],
+  [402,'Insufficient credits.','credits','upstream'],
+  [404,'Unknown provider rejection.',undefined,'model_access'],
+  [503,'No endpoints found for this model.',undefined,'upstream'],
+ ]){
+  await assert.rejects(compatibleTextResponse(request,router,async()=>Response.json({error:{message:message+' synthetic-private-case-marker',metadata:{private:'synthetic-private-router-key'}}},{status})),error=>{
+   assert.equal(error.kind,kind);assert.equal(error.reason,reason);assert.equal(error.upstreamStatus,status);
+   assert.doesNotMatch(JSON.stringify(error)+error.message,/synthetic-private|No endpoints|Insufficient credits/);return true;
+  });
+ }
+});
+
+test('oversized, malformed and non-JSON upstream bodies stay generic and the error reader cancels oversized streams',async()=>{
+ for(const raw of ['not JSON','{"error":',JSON.stringify({error:{message:'x'.repeat(9000)+'No endpoints found matching your data policy'}})]){
+  await assert.rejects(compatibleTextResponse(request,router,async()=>new Response(raw,{status:404})),error=>error.kind==='model_access'&&error.reason===undefined);
+ }
+ let cancelled=false;
+ const body=new ReadableStream({start(controller){controller.enqueue(new Uint8Array(8200));},cancel(){cancelled=true;}});
+ await assert.rejects(compatibleTextResponse(request,router,async()=>new Response(body,{status:404})),error=>error.reason===undefined);
+ assert.equal(cancelled,true);
+});
