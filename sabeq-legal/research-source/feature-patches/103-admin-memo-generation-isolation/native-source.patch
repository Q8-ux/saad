+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {load} from './template-harness.mjs';
+const security=load('../lib/request-security.ts',{'@/db':{getD1(){throw Error('Unexpected database access');}}});
+const {validateMemoInput}=load('../lib/memo-input.ts',{'@/lib/request-security':security});
+const current={caseType:'مطالبة مدنية',clientName:'صاحب القضية الافتراضي',otherParty:'الخصم الافتراضي الحالي',partyRole:'مدعى عليه',court:'المحكمة الكلية',caseNumber:'SYNTHETIC-A',documentKind:'memorandum',facts:'في تاريخ 2026/01/01 أقام الخصم الافتراضي الحالي دعوى على صاحب القضية الافتراضي بطلب مبلغ 100 دينار كويتي عن دين مزعوم. ينكر صاحب القضية الافتراضي المديونية ويتمسك بعدم وجود مستند يثبت تسلمه هذا المبلغ.',requests:'رفض الدعوى لعدم ثبوت المديونية.'};
+test('unrelated original parties are rejected before any payment or model request',()=>{
+ assert.throws(()=>validateMemoInput({...current,originalDefendant:'طرف قضية أخرى افتراضية',originalGrounds:'وقائع اصطناعية من قضية سابقة',judgmentOperative:'منطوق يخص القضية السابقة'}),e=>e.status===422&&e.stage==='case_context_review'&&e.conflictingFields.includes('originalDefendant'));
+});
+test('matching original parties and a different appealed judgment number remain valid',()=>{
+ const input=validateMemoInput({...current,originalPlaintiff:current.otherParty,originalDefendant:current.clientName,judgmentNumber:'SYNTHETIC-FIRST-INSTANCE'});
+ assert.equal(input.extraFields.originalDefendant,current.clientName);
+});
+const context=load('../lib/memo-case-context.ts');
+test('a new matter drops every prior private field; an update to the same matter retains its fields',()=>{
+ const old={...current,originalDefendant:'طرف سابق',documentContext:'private synthetic prior document',conversationTranscript:'synthetic prior chat',assistantSourceIds:'[123]',hearingDate:'2026-01-02'};
+ const next=context.mergeMemoCasePatch(old,{clientName:'موكل اصطناعي مختلف',facts:'وقائع القضية الجديدة فقط',caseNumber:'SYNTHETIC-B'});
+ for(const key of ['originalDefendant','documentContext','conversationTranscript','assistantSourceIds','hearingDate','requests','otherParty'])assert.equal(next[key],undefined,key);
+ assert.equal(old.documentContext,'private synthetic prior document');
+ assert.equal(context.mergeMemoCasePatch(old,{facts:'تصحيح وقائع القضية الحالية'}).hearingDate,'2026-01-02');
+});
+test('a named original party explicitly supported in the current facts is accepted',()=>{
+ assert.equal(context.reviewMemoCaseContext({...current,originalDefendant:'خصم اصطناعي متدخل',facts:current.facts+' تدخل خصم اصطناعي متدخل في الدعوى.'}).valid,true);
+ assert.equal(context.reviewMemoCaseContext({...current,otherParty:'النيابة العامة',originalPlaintiff:'الادعاء العام'}).valid,true);
+});
+test('server generation authority is isolated across concurrent requests and removed after failure',async()=>{
+ const trusted=load('../lib/management-generation-context.ts'),a=new Request('https://example.test/a'),b=new Request('https://example.test/b',{headers:{'X-Management-Generation':'true'}});
+ let release;const waiting=new Promise(resolve=>{release=resolve;});
+ const running=trusted.withManagementGeneration(a,{parentRequestId:'synthetic-a',onStarted:async()=>{}},async()=>{await waiting;assert.equal(trusted.managementGenerationContext(a).parentRequestId,'synthetic-a');});
+ assert.equal(trusted.managementGenerationContext(b),undefined);release();await running;
+ assert.equal(trusted.managementGenerationContext(a),undefined);
+ await assert.rejects(trusted.withManagementGeneration(a,{onStarted:async()=>{}},async()=>{throw Error('synthetic failure');}));
+ assert.equal(trusted.managementGenerationContext(a),undefined);
+});
