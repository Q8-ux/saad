+  return {id,fields,fieldLabels,context:reviewMemoCaseContext(fields),expectedHash:row?await sourceHash(row):"",operationId:crypto.randomUUID(),canRepair:!!row&&!row.output_text.trim(),hasSavedMemo:!!row?.output_text.trim()};
