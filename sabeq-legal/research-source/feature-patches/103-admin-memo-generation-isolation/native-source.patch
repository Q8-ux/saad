+ '@/lib/request-security':{...security,enforceRateLimit:async()=>{}},
+}).POST;}
+async function run(message){const response=await handlers()(new Request('https://example.test/api/legal/assistant',{method:'POST',headers:{Origin:'https://example.test','Content-Type':'application/json'},body:JSON.stringify({message,messages:[],language:'ar'})}));assert.equal(response.status,200);return (await response.json()).state;}
+test('provider outage retains explicitly stated current court, criminal subtype and role without inventing authority',async()=>{
+ const state=await run('اختبار اصطناعي فقط: أنا المتهم الخامس في قضية منظورة أمام محكمة الجنح، الدائرة 24، بجنحة سب وقذف. أنكر الواقعة وأطلب البراءة.');
+ assert.equal(state.caseType,'جنحة');assert.equal(state.court,'محكمة الجنح');assert.match(state.courtCircuit,/24/);assert.equal(state.memoPrefill.partyRole,'متهم');assert.equal(state.memoPrefill.court,state.court);assert.equal(state.memoPrefill.caseType,state.caseType);
