+export async function memoGenerationAction(data:Record<string,unknown>,actor:string,request:Request,engine?: (request:Request)=>Promise<Response>) {
+  if(Object.keys(data).some(key=>!["id","fields","expectedHash","operationId","action","reviewed"].includes(key))||!["repair","generate"].includes(String(data.action))||data.reviewed!==true)throw new RequestError("راجع بيانات هذه القضية وأكد استقلالها قبل الحفظ أو التوليد.");
+  const id=idValue(data.id),key=operationKey(data.operationId),fields=fieldsFrom(data.fields);
+  const fingerprint=await digest(JSON.stringify([actor,data.action,id,data.expectedHash,fields]));
+  const previous=await readReceipt(key,actor);
+  if(previous){if(previous.fingerprint!==fingerprint)throw new RequestError("استُخدم معرف العملية لبيانات أخرى. أعد فتح النموذج.",409);return publicReceipt(previous);}
