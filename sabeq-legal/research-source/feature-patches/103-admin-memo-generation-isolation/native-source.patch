+function idValue(value:unknown) {
+  const id=cleanString(value,"معرف الطلب",{max:100,required:false});
+  if(id&&!/^[A-Za-z0-9_-]+$/.test(id))throw new RequestError("التوليد من الأرشيف السابق غير متاح. أنشئ طلباً مستقلاً ببيانات القضية المراجعة.",409);
