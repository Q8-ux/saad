generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  SUPERVISOR
  EMPLOYEE
  AUDITOR
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceDecision {
  ACCEPTED
  ACCEPTED_WITH_WARNING
  REJECTED
  REVIEW_REQUIRED
}

enum StationType {
  GENERATION
  SUBSTATION
  CONTROL_CENTER
  MONITORING_SITE
}

enum TransferPermitStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  READY
  DEPARTED
  IN_TRANSIT
  ARRIVED
  AT_DESTINATION
  RETURNING
  COMPLETED
  DELAYED
  EXPIRED
  CANCELLED
  REVIEW_REQUIRED
}

enum TransferLocationEventType {
  ORIGIN_EXIT
  TRANSIT_CHECK
  DESTINATION_ENTRY
  ARRIVAL_CONFIRMED
  DESTINATION_EXIT
  RETURN_ARRIVAL
  LOCATION_ANOMALY
}

enum EmergencyType {
  FIRE
  EXPLOSION
  FUEL_LEAK
  HAZARDOUS_MATERIAL
  MEDICAL
  POWER_FAILURE
  OPERATIONAL_FAILURE
  SECURITY
  NATURAL_DISASTER
  EVACUATION
  OTHER
}

enum EmergencyStatus {
  DRAFT
  ACTIVE
  CONTAINED
  CLOSED
  CANCELLED
}

enum SafeLocationType {
  ASSEMBLY_POINT
  SHELTER
}

enum EvacuationStatus {
  NOT_CONFIRMED
  DIRECTED
  IN_TRANSIT
  SAFE
  MISSING
  INJURED
  EXEMPT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  ASSIGN_ROLE
  ASSIGN_STATION
  EXPORT
}

model Company {
  id                 String                 @id @default(uuid())
  nameAr             String
  nameEn             String?
  users              User[]
  employees          Employee[]
  attendances        Attendance[]
  stations           Station[]
  transferPermits    TransferPermit[]
  emergencyIncidents EmergencyIncident[]
  auditLogs          AuditLog[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model User {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email             String
  passwordHash      String
  role              Role             @default(EMPLOYEE)
  employee          Employee?
  stationAccess     UserStation[]
  approvedTransfers TransferPermit[] @relation("TransferApprover")
  emergencyCreated  EmergencyIncident[] @relation("EmergencyCreator")
  auditLogs         AuditLog[]
  isActive          Boolean          @default(true)
  failedAttempts    Int              @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([companyId, email])
  @@index([companyId, role, isActive])
}

model Employee {
  id                 String                @id @default(uuid())
  companyId          String
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId             String?               @unique
  user               User?                 @relation(fields: [userId], references: [id])
  employeeNo         String
  fullNameAr         String
  fullNameEn         String?
  department         String?
  jobTitle           String?
  isActive           Boolean               @default(true)
  attendances        Attendance[]
  transferPermits    TransferPermit[]
  emergencyStatuses EmergencyEvacuation[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([companyId, employeeNo])
  @@index([companyId, fullNameAr])
}

model Station {
  id                   String           @id @default(uuid())
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                 String
  nameAr               String
  nameEn               String?
  type                 StationType
  areaAr               String?
  areaEn               String?
  latitude             Decimal?         @db.Decimal(10, 7)
  longitude            Decimal?         @db.Decimal(10, 7)
  geofenceM            Int              @default(250)
  arrivalDwellSeconds  Int              @default(120)
  maxGpsAccuracyM      Int              @default(100)
  isActive             Boolean          @default(true)
  userAccess           UserStation[]
  attendances          Attendance[]
  originTransfers      TransferPermit[] @relation("TransferOrigin")
  destinationTransfers TransferPermit[] @relation("TransferDestination")
  assemblyPoints       AssemblyPoint[]
  shelters             Shelter[]
  criticalAssets       CriticalAsset[]
  emergencyIncidents   EmergencyIncident[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([companyId, code])
  @@index([companyId, type, isActive])
}

model UserStation {
  userId     String
  stationId  String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, stationId])
  @@index([stationId])
}

model Attendance {
  id                   String             @id @default(uuid())
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  stationId            String?
  station              Station?           @relation(fields: [stationId], references: [id], onDelete: SetNull)
  type                 AttendanceType
  decision             AttendanceDecision @default(ACCEPTED)
  recordedAt           DateTime           @default(now())
  locationTimestamp    DateTime?
  latitude             Decimal?           @db.Decimal(10, 7)
  longitude            Decimal?           @db.Decimal(10, 7)
  accuracyM            Decimal?           @db.Decimal(8, 2)
  distanceFromStationM Decimal?           @db.Decimal(10, 2)
  geofenceRadiusM      Int?
  deviceId             String?
  mockLocationDetected Boolean            @default(false)
  deviceIntegrity      String?
  riskScore            Int                @default(0)
  riskReasons          Json?
  rejectionReason      String?
  source               String             @default("MOBILE")
  createdAt            DateTime           @default(now())

  @@index([companyId, recordedAt])
  @@index([employeeId, recordedAt])
  @@index([stationId, recordedAt])
  @@index([decision, riskScore])
}

model TransferPermit {
  id                      String               @id @default(uuid())
  companyId               String
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId              String
  employee                Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  originStationId         String
  originStation           Station              @relation("TransferOrigin", fields: [originStationId], references: [id])
  destinationStationId    String
  destinationStation      Station              @relation("TransferDestination", fields: [destinationStationId], references: [id])
  reason                  String
  status                  TransferPermitStatus @default(PENDING_APPROVAL)
  validFrom               DateTime
  validUntil              DateTime
  expectedDistanceKm      Decimal?             @db.Decimal(10, 2)
  expectedDurationMinutes Int?
  actualDepartureAt       DateTime?
  actualArrivalAt         DateTime?
  completedAt             DateTime?
  approvedByUserId        String?
  approvedBy              User?                @relation("TransferApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt              DateTime?
  riskScore               Int                  @default(0)
  riskReasons             Json?
  reviewStatus            String?
  locationEvents          TransferLocationEvent[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([companyId, status, validFrom])
  @@index([employeeId, validFrom])
  @@index([originStationId, destinationStationId])
}

model TransferLocationEvent {
  id                   String                    @id @default(uuid())
  permitId             String
  permit               TransferPermit            @relation(fields: [permitId], references: [id], onDelete: Cascade)
  eventType            TransferLocationEventType
  latitude             Decimal                   @db.Decimal(10, 7)
  longitude            Decimal                   @db.Decimal(10, 7)
  accuracyM            Decimal?                  @db.Decimal(8, 2)
  distanceFromStationM Decimal?                  @db.Decimal(10, 2)
  deviceId             String?
  mockLocationDetected Boolean                   @default(false)
  deviceIntegrity      String?
  riskScore            Int                       @default(0)
  riskReasons          Json?
  recordedAt           DateTime                  @default(now())

  @@index([permitId, recordedAt])
  @@index([eventType, recordedAt])
}

model AssemblyPoint {
  id             String                @id @default(uuid())
  stationId      String
  station        Station               @relation(fields: [stationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String?
  latitude       Decimal               @db.Decimal(10, 7)
  longitude      Decimal               @db.Decimal(10, 7)
  geofenceM      Int                   @default(50)
  capacity       Int?
  targetMinutes  Int?
  readiness      String                @default("READY")
  isActive       Boolean               @default(true)
  evacuations    EmergencyEvacuation[] @relation("AssemblyDestination")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([stationId, code])
  @@index([stationId, isActive])
}

model Shelter {
  id             String                @id @default(uuid())
  stationId      String
  station        Station               @relation(fields: [stationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String?
  latitude       Decimal               @db.Decimal(10, 7)
  longitude      Decimal               @db.Decimal(10, 7)
  geofenceM      Int                   @default(40)
  capacity       Int?
  shelterType    String
  equipment      Json?
  readiness      String                @default("READY")
  isActive       Boolean               @default(true)
  evacuations    EmergencyEvacuation[] @relation("ShelterDestination")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([stationId, code])
  @@index([stationId, isActive])
}

model CriticalAsset {
  id          String   @id @default(uuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  code        String
  nameAr      String
  nameEn      String?
  assetType   String
  riskLevel   Int      @default(1)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  responsePlan Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([stationId, code])
  @@index([stationId, riskLevel, isActive])
}

model EmergencyIncident {
  id              String                @id @default(uuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stationId       String
  station         Station               @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?                 @relation("EmergencyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  type            EmergencyType
  status          EmergencyStatus       @default(ACTIVE)
  severity        Int                   @default(1)
  titleAr         String
  description     String?
  latitude        Decimal?              @db.Decimal(10, 7)
  longitude       Decimal?              @db.Decimal(10, 7)
  instructions    Json?
  activatedAt     DateTime              @default(now())
  containedAt     DateTime?
  closedAt        DateTime?
  evacuations     EmergencyEvacuation[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([companyId, status, activatedAt])
  @@index([stationId, status])
}

model EmergencyEvacuation {
  id                String             @id @default(uuid())
  incidentId        String
  incident          EmergencyIncident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  destinationType   SafeLocationType?
  assemblyPointId   String?
  assemblyPoint     AssemblyPoint?     @relation("AssemblyDestination", fields: [assemblyPointId], references: [id], onDelete: SetNull)
  shelterId         String?
  shelter           Shelter?           @relation("ShelterDestination", fields: [shelterId], references: [id], onDelete: SetNull)
  status            EvacuationStatus   @default(NOT_CONFIRMED)
  directedAt        DateTime?
  arrivedAt         DateTime?
  lastLatitude      Decimal?           @db.Decimal(10, 7)
  lastLongitude     Decimal?           @db.Decimal(10, 7)
  lastAccuracyM     Decimal?           @db.Decimal(8, 2)
  riskScore         Int                @default(0)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([incidentId, employeeId])
  @@index([incidentId, status])
  @@index([employeeId, createdAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
