generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { SUPER_ADMIN COMPANY_ADMIN HR_MANAGER SUPERVISOR EMPLOYEE AUDITOR }
enum AttendanceType { CHECK_IN CHECK_OUT }
enum StationType { GENERATION SUBSTATION CONTROL_CENTER MONITORING_SITE }
enum AuditAction { CREATE UPDATE DELETE LOGIN LOGIN_FAILED LOGOUT ASSIGN_ROLE ASSIGN_STATION EXPORT }

model Company {
  id          String       @id @default(uuid())
  nameAr      String
  nameEn      String?
  users       User[]
  employees   Employee[]
  attendances Attendance[]
  stations    Station[]
  auditLogs   AuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  role           Role          @default(EMPLOYEE)
  employee       Employee?
  stationAccess  UserStation[]
  auditLogs      AuditLog[]
  isActive       Boolean       @default(true)
  failedAttempts Int           @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  passwordChangedAt DateTime   @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@unique([companyId, email])
  @@index([companyId, role, isActive])
}

model Employee {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id])
  employeeNo   String
  fullNameAr   String
  fullNameEn   String?
  department   String?
  jobTitle     String?
  isActive     Boolean      @default(true)
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@unique([companyId, employeeNo])
  @@index([companyId, fullNameAr])
}

model Station {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  nameAr      String
  nameEn      String?
  type        StationType
  areaAr      String?
  areaEn      String?
  latitude    Decimal?      @db.Decimal(10, 7)
  longitude   Decimal?      @db.Decimal(10, 7)
  geofenceM   Int           @default(250)
  isActive    Boolean       @default(true)
  userAccess  UserStation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([companyId, code])
  @@index([companyId, type, isActive])
}

model UserStation {
  userId      String
  stationId   String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  station     Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())
  @@id([userId, stationId])
  @@index([stationId])
}

model Attendance {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        AttendanceType
  recordedAt  DateTime       @default(now())
  latitude    Decimal?       @db.Decimal(10, 7)
  longitude   Decimal?       @db.Decimal(10, 7)
  accuracyM   Decimal?       @db.Decimal(8, 2)
  deviceId    String?
  source      String         @default("MOBILE")
  createdAt   DateTime       @default(now())
  @@index([companyId, recordedAt])
  @@index([employeeId, recordedAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
