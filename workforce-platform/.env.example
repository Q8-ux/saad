POSTGRES_DB=workforce
POSTGRES_USER=workforce
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://workforce:change_me@db:5432/workforce?schema=public
JWT_SECRET=replace-with-64-random-characters
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# OpenAI — server side only
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_MODEL=gpt-5-mini

# WhatsApp Business provider — configure before enabling dispatch
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=replace-with-provider-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_TEMPLATE_NAMESPACE=replace-if-required

# Email provider
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace
SMTP_PASSWORD=replace
EMAIL_FROM="Work Scope Platform <noreply@example.com>"
EMAIL_REPLY_TO=support@example.com
EMAIL_BRAND_NAME=منصة نطاق العمل
WEB_APP_URL=https://q8-ux.github.io/saad/
EMAIL_TOKEN_SECRET=replace-with-a-different-64-character-random-secret
EMAIL_ACTIVATION_TTL_SECONDS=86400
EMAIL_RESET_TTL_SECONDS=1800

# Push notifications
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=replace
FIREBASE_CLIENT_EMAIL=replace
FIREBASE_PRIVATE_KEY=replace
