MASAR_CONFIG=config.local.json
MASAR_DEMO_TOKEN=GENERATE_WITH_MASAR_INIT
# Enhanced is loaded from a separate installation; its source is not redistributed.
MASAR_ENHANCED_DIR=.runtime/patchright-enhanced
# Optional path to an already installed compatible Chromium browser.
MASAR_BROWSER_EXECUTABLE_PATH=
# Optional: connect the project's existing model from the backend only.
MASAR_LLM_BASE_URL=
MASAR_LLM_MODEL=
MASAR_LLM_API_KEY=
# Optional: explicit read-only upstream tools. Never paste credentials into GitHub.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
MASAR_REDDIT_CREDENTIAL_FILE=
# Required only for optional networked upstream CLI adapters, after egress isolation.
MASAR_UPSTREAM_EGRESS_ISOLATED=0
