{
  "schema_version": 1,
  "project": "الدكتورة نوره العتال",
  "module": "../masar-photoshop/compositor.py",
  "upstream": "https://github.com/robbietilton/Compositor",
  "use": "course-covers",
  "font_policy": "existing-project-font",
  "font_policy_enforcement": "manual-review-of-approved-text-layer",
  "requires_cutout": false,
  "review_rules": [
    "approved-excerpts-only",
    "no-ai-writing",
    "no-video-library"
  ],
  "face_retouch": false,
  "status": "manual-production-adapter-configured; not wired to live website",
  "exports": [
    "comp",
    "png",
    "jpg",
    "webp",
    "pdf"
  ],
  "publishing": "manual-approved-export-only"
}
