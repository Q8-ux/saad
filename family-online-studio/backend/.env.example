STUDIO_ALLOWED_ORIGIN=https://q8-ux.github.io
STUDIO_UPSTREAM_ORIGIN=
STUDIO_SITE_TOKEN=
STUDIO_BRIDGE_KEY=
STUDIO_ACCESS_SHA256=
STUDIO_SESSION_SECRET=

# Optional SMS login. Keep all values in the backend environment only.
# An active primary Twilio Trial account (under 30 days old) is required.
# Paid/Full accounts are rejected by this integration.
STUDIO_OWNER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: automatically discover one existing six-digit Verify service on the Trial account.
# Set this explicitly if the account has multiple services.
TWILIO_VERIFY_SERVICE_SID=

