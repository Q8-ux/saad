{
  "schema_version": 1,
  "project": "نظام تموينات",
  "module": "../masar-photoshop/compositor.py",
  "upstream": "https://github.com/robbietilton/Compositor",
  "use": "product-assets",
  "font_policy": "المهند",
  "font_policy_enforcement": "manual-review-of-approved-text-layer",
  "requires_cutout": false,
  "review_rules": [
    "real-products-only",
    "approved-prices-only",
    "consistent-framing"
  ],
  "face_retouch": false,
  "status": "manual-production-adapter-configured; not wired to live website",
  "exports": [
    "comp",
    "png",
    "jpg",
    "webp",
    "pdf"
  ],
  "publishing": "manual-approved-export-only",
  "canva": {
    "folder_id": "FAHXXqEL9K8",
    "connection": "authenticated-Canva-connector",
    "bridge": "../masar-photoshop/canva-bridge.mjs",
    "upload": "reviewed-raster-assets",
    "reverse_transfer": "manual-export-required",
    "auto_sync": false
  }
}
