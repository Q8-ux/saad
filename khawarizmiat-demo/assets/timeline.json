[
  {
    "id": "r01_1",
    "sourceId": "r01",
    "scene": "s1",
    "speaker": "ريم",
    "text": "دانا إذا سالم دز لج مقطع عني",
    "start": 3.057,
    "end": 5.316
  },
  {
    "id": "r01_2",
    "sourceId": "r01",
    "scene": "s1",
    "speaker": "ريم",
    "text": "خليه يدز الملف كامل",
    "start": 5.316,
    "end": 7.152
  },
  {
    "id": "r01_3",
    "sourceId": "r01",
    "scene": "s1",
    "speaker": "ريم",
    "text": "اللي انقص أهم من اللي بيشوفونه الناس",
    "start": 7.152,
    "end": 9.665
  },
  {
    "id": "d01_1",
    "sourceId": "d01",
    "scene": "s1",
    "speaker": "دانا",
    "text": "ريم ردي علي",
    "start": 12.303,
    "end": 13.151
  },
  {
    "id": "d01_2",
    "sourceId": "d01",
    "scene": "s1",
    "speaker": "دانا",
    "text": "من قبل ما ينزل المقطع وإنتي ما تردين",
    "start": 13.151,
    "end": 15.739
  },
  {
    "id": "d01_3",
    "sourceId": "d01",
    "scene": "s1",
    "speaker": "دانا",
    "text": "وأمي قاعدة تسألني عنج",
    "start": 15.739,
    "end": 17.271
  },
  {
    "id": "r02_1",
    "sourceId": "r02",
    "scene": "s2",
    "speaker": "ريم",
    "text": "لا تفتحين الباب",
    "start": 25.057,
    "end": 26.165
  },
  {
    "id": "r02_2",
    "sourceId": "r02",
    "scene": "s2",
    "speaker": "ريم",
    "text": "خلي البنت هني",
    "start": 26.281,
    "end": 27.483
  },
  {
    "id": "d02_1",
    "sourceId": "d02",
    "scene": "s2",
    "speaker": "دانا",
    "text": "سالم هذا صوت أختي",
    "start": 29.569,
    "end": 30.912
  },
  {
    "id": "d02_2",
    "sourceId": "d02",
    "scene": "s2",
    "speaker": "دانا",
    "text": "بس منو البنت اللي يتكلمون عنها",
    "start": 30.98,
    "end": 32.957
  },
  {
    "id": "d02_3",
    "sourceId": "d02",
    "scene": "s2",
    "speaker": "دانا",
    "text": "وليش كاتبين إنها حابستها",
    "start": 32.957,
    "end": 34.631
  },
  {
    "id": "s01_1",
    "sourceId": "s01",
    "scene": "s2",
    "speaker": "سالم",
    "text": "أنا نشرت المقطع بحساب الواجهة",
    "start": 36.705,
    "end": 38.824
  },
  {
    "id": "s01_2",
    "sourceId": "s01",
    "scene": "s2",
    "speaker": "سالم",
    "text": "والناس خذت العنوان وركبت عليه سالفة",
    "start": 38.824,
    "end": 41.507
  },
  {
    "id": "s01_3",
    "sourceId": "s01",
    "scene": "s2",
    "speaker": "سالم",
    "text": "الحين ما أقدر ألحق كل اللي أعادوه",
    "start": 41.507,
    "end": 43.84
  },
  {
    "id": "d03_1",
    "sourceId": "d03",
    "scene": "s2",
    "speaker": "دانا",
    "text": "أنت اللي كتبت العنوان",
    "start": 45.92,
    "end": 47.31
  },
  {
    "id": "d03_2",
    "sourceId": "d03",
    "scene": "s2",
    "speaker": "دانا",
    "text": "ولا الناس كتبوه عنك",
    "start": 47.379,
    "end": 48.723
  },
  {
    "id": "s02_1",
    "sourceId": "s02",
    "scene": "s3",
    "speaker": "سالم",
    "text": "أنا كتبته",
    "start": 55.057,
    "end": 55.81
  },
  {
    "id": "s02_2",
    "sourceId": "s02",
    "scene": "s3",
    "speaker": "سالم",
    "text": "بس اللي تشوفينه قدامج هذا صار",
    "start": 55.81,
    "end": 58.023
  },
  {
    "id": "s02_3",
    "sourceId": "s02",
    "scene": "s3",
    "speaker": "سالم",
    "text": "ما ركبت كلام على صوتها",
    "start": 58.023,
    "end": 59.602
  },
  {
    "id": "d04_1",
    "sourceId": "d04",
    "scene": "s3",
    "speaker": "دانا",
    "text": "إذا قصيت الكلام اللي يشرح ليش تسكر الباب",
    "start": 62.144,
    "end": 64.994
  },
  {
    "id": "d04_2",
    "sourceId": "d04",
    "scene": "s3",
    "speaker": "دانا",
    "text": "أنت غيرت المعنى",
    "start": 65.062,
    "end": 66.475
  },
  {
    "id": "d04_3",
    "sourceId": "d04",
    "scene": "s3",
    "speaker": "دانا",
    "text": "حتى لو كل كلمة قالتها موجودة",
    "start": 66.475,
    "end": 68.666
  },
  {
    "id": "s03_1",
    "sourceId": "s03",
    "scene": "s3",
    "speaker": "سالم",
    "text": "دزيت لج ملف المشروع ونسخة التصوير",
    "start": 71.208,
    "end": 73.891
  },
  {
    "id": "s03_2",
    "sourceId": "s03",
    "scene": "s3",
    "speaker": "سالم",
    "text": "أنا فاتح لج اللي عندي",
    "start": 73.891,
    "end": 75.256
  },
  {
    "id": "s03_3",
    "sourceId": "s03",
    "scene": "s3",
    "speaker": "سالم",
    "text": "شوفيه قبل لا تحكمين علي",
    "start": 75.256,
    "end": 76.882
  },
  {
    "id": "d05_1",
    "sourceId": "d05",
    "scene": "s4",
    "speaker": "دانا",
    "text": "أمي وصلها المقطع من قروب العايلة",
    "start": 89.557,
    "end": 91.817
  },
  {
    "id": "d05_2",
    "sourceId": "d05",
    "scene": "s4",
    "speaker": "دانا",
    "text": "كل واحد يكتب يمكن",
    "start": 91.817,
    "end": 93.37
  },
  {
    "id": "d05_3",
    "sourceId": "d05",
    "scene": "s4",
    "speaker": "دانا",
    "text": "وأنا اللي لازم أرد عليها وين بنتها",
    "start": 93.37,
    "end": 95.468
  },
  {
    "id": "s04_1",
    "sourceId": "s04",
    "scene": "s4",
    "speaker": "سالم",
    "text": "إذا تبين أحذف النسخة اللي عندي أحذفها",
    "start": 96.781,
    "end": 99.794
  },
  {
    "id": "s04_2",
    "sourceId": "s04",
    "scene": "s4",
    "speaker": "سالم",
    "text": "بس النسخ الثانية ما راح تختفي",
    "start": 99.794,
    "end": 101.75
  },
  {
    "id": "d06_1",
    "sourceId": "d06",
    "scene": "s4",
    "speaker": "دانا",
    "text": "أبي الأصل قبل الحذف",
    "start": 103.059,
    "end": 104.45
  },
  {
    "id": "d06_2",
    "sourceId": "d06",
    "scene": "s4",
    "speaker": "دانا",
    "text": "لا يضيع الشي الوحيد اللي يوضح شصار",
    "start": 104.612,
    "end": 107.18
  },
  {
    "id": "d07_1",
    "sourceId": "d07",
    "scene": "s5",
    "speaker": "دانا",
    "text": "شوف الساعة تحت الصورة",
    "start": 114.557,
    "end": 115.969
  },
  {
    "id": "d07_2",
    "sourceId": "d07",
    "scene": "s5",
    "speaker": "دانا",
    "text": "هذي مصورة الساعة تسع ودقيقتين",
    "start": 115.969,
    "end": 118.678
  },
  {
    "id": "d07_3",
    "sourceId": "d07",
    "scene": "s5",
    "speaker": "دانا",
    "text": "وإنت ناشرها تسع وسبع عشرة دقيقة",
    "start": 118.699,
    "end": 121.69
  },
  {
    "id": "s05_1",
    "sourceId": "s05",
    "scene": "s5",
    "speaker": "سالم",
    "text": "صحيح هذا وقت التصوير",
    "start": 124.057,
    "end": 125.752
  },
  {
    "id": "s05_2",
    "sourceId": "s05",
    "scene": "s5",
    "speaker": "سالم",
    "text": "واللي فوق وقت النشر",
    "start": 125.752,
    "end": 127.023
  },
  {
    "id": "s05_3",
    "sourceId": "s05",
    "scene": "s5",
    "speaker": "سالم",
    "text": "النسخة عندي من قبل",
    "start": 127.023,
    "end": 128.225
  },
  {
    "id": "d08_1",
    "sourceId": "d08",
    "scene": "s5",
    "speaker": "دانا",
    "text": "يعني لما الناس يقولون ريم الحين بهالمكان",
    "start": 130.591,
    "end": 133.085
  },
  {
    "id": "d08_2",
    "sourceId": "d08",
    "scene": "s5",
    "speaker": "دانا",
    "text": "هم قاعدين يتبعون وقت النشر",
    "start": 133.085,
    "end": 135.016
  },
  {
    "id": "d08_3",
    "sourceId": "d08",
    "scene": "s5",
    "speaker": "دانا",
    "text": "ويمكن هي طلعت منه",
    "start": 135.016,
    "end": 136.36
  },
  {
    "id": "s06_1",
    "sourceId": "s06",
    "scene": "s6",
    "speaker": "سالم",
    "text": "هذا سجل المشروع",
    "start": 152.057,
    "end": 153.234
  },
  {
    "id": "s06_2",
    "sourceId": "s06",
    "scene": "s6",
    "speaker": "سالم",
    "text": "شغلت النشر المجدول بعد القص",
    "start": 153.234,
    "end": 155.331
  },
  {
    "id": "s06_3",
    "sourceId": "s06",
    "scene": "s6",
    "speaker": "سالم",
    "text": "المقطع ينزل حتى لو سكرت جهازي",
    "start": 155.352,
    "end": 158.061
  },
  {
    "id": "d09_1",
    "sourceId": "d09",
    "scene": "s6",
    "speaker": "دانا",
    "text": "وقف أي شي مجدول الحين",
    "start": 161.028,
    "end": 163.052
  },
  {
    "id": "d09_2",
    "sourceId": "d09",
    "scene": "s6",
    "speaker": "دانا",
    "text": "وما أبي لقطة بروحها",
    "start": 163.052,
    "end": 164.464
  },
  {
    "id": "d09_3",
    "sourceId": "d09",
    "scene": "s6",
    "speaker": "دانا",
    "text": "افتح الصوت من قبل الجملة اللي نشرتها",
    "start": 164.464,
    "end": 167.173
  },
  {
    "id": "r03_1",
    "sourceId": "r03",
    "scene": "s7",
    "speaker": "ريم",
    "text": "لا تفتحين الباب",
    "start": 173.057,
    "end": 174.165
  },
  {
    "id": "r03_2",
    "sourceId": "r03",
    "scene": "s7",
    "speaker": "ريم",
    "text": "خلي البنت هني",
    "start": 174.281,
    "end": 175.41
  },
  {
    "id": "r03_3",
    "sourceId": "r03",
    "scene": "s7",
    "speaker": "ريم",
    "text": "اللي واقف برا يصورها غصب ويهددها",
    "start": 175.41,
    "end": 177.811
  },
  {
    "id": "r03_4",
    "sourceId": "r03",
    "scene": "s7",
    "speaker": "ريم",
    "text": "أنا بروح أنادي الحارس",
    "start": 177.811,
    "end": 179.484
  },
  {
    "id": "r03_5",
    "sourceId": "r03",
    "scene": "s7",
    "speaker": "ريم",
    "text": "وإذا رجعت أدق ثلاث دقات",
    "start": 179.6,
    "end": 181.509
  },
  {
    "id": "r03_6",
    "sourceId": "r03",
    "scene": "s7",
    "speaker": "ريم",
    "text": "لا تفتحين حق أحد قبلي",
    "start": 181.577,
    "end": 183.438
  },
  {
    "id": "d10_1",
    "sourceId": "d10",
    "scene": "s7",
    "speaker": "دانا",
    "text": "كانت تحميها يا سالم",
    "start": 186.479,
    "end": 187.917
  },
  {
    "id": "d10_2",
    "sourceId": "d10",
    "scene": "s7",
    "speaker": "دانا",
    "text": "البنت مو محبوسة منها",
    "start": 187.986,
    "end": 189.633
  },
  {
    "id": "d10_3",
    "sourceId": "d10",
    "scene": "s7",
    "speaker": "دانا",
    "text": "البنت خايفة من اللي واقف برا",
    "start": 189.633,
    "end": 191.589
  },
  {
    "id": "s07_1",
    "sourceId": "s07",
    "scene": "s7",
    "speaker": "سالم",
    "text": "إي كنت أدري إن السياق ناقص",
    "start": 194.633,
    "end": 196.845
  },
  {
    "id": "s07_2",
    "sourceId": "s07",
    "scene": "s7",
    "speaker": "سالم",
    "text": "قلت أنزل الباقي بعدين",
    "start": 196.845,
    "end": 198.304
  },
  {
    "id": "s07_3",
    "sourceId": "s07",
    "scene": "s7",
    "speaker": "سالم",
    "text": "وأصلح اللي فهموه",
    "start": 198.304,
    "end": 199.413
  },
  {
    "id": "d11_1",
    "sourceId": "d11",
    "scene": "s8",
    "speaker": "دانا",
    "text": "إنت كنت تدري إنهم بيفهمون غلط",
    "start": 209.057,
    "end": 211.059
  },
  {
    "id": "d11_2",
    "sourceId": "d11",
    "scene": "s8",
    "speaker": "دانا",
    "text": "ومع هذا خليتهم يحكمون عليها",
    "start": 211.175,
    "end": 213.528
  },
  {
    "id": "d11_3",
    "sourceId": "d11",
    "scene": "s8",
    "speaker": "دانا",
    "text": "لين يجهز الجزء الثاني",
    "start": 213.528,
    "end": 215.296
  },
  {
    "id": "s08_1",
    "sourceId": "s08",
    "scene": "s8",
    "speaker": "سالم",
    "text": "كنت أبي المقطع ينتشر",
    "start": 217.719,
    "end": 219.251
  },
  {
    "id": "s08_2",
    "sourceId": "s08",
    "scene": "s8",
    "speaker": "سالم",
    "text": "والحين أنا قاعد أشوف شسويت",
    "start": 219.272,
    "end": 221.109
  },
  {
    "id": "s08_3",
    "sourceId": "s08",
    "scene": "s8",
    "speaker": "سالم",
    "text": "أقدر أنزل الأصل وأكتب إني قصيته",
    "start": 221.109,
    "end": 223.63
  },
  {
    "id": "d12_1",
    "sourceId": "d12",
    "scene": "s8",
    "speaker": "دانا",
    "text": "نزله وقل شنو حذفت",
    "start": 226.042,
    "end": 227.527
  },
  {
    "id": "d12_2",
    "sourceId": "d12",
    "scene": "s8",
    "speaker": "دانا",
    "text": "لا تكتب سوء تفاهم وتسكت",
    "start": 227.877,
    "end": 229.692
  },
  {
    "id": "d12_3",
    "sourceId": "d12",
    "scene": "s8",
    "speaker": "دانا",
    "text": "هي مختفية وأنا للحين ما أعرف وينها",
    "start": 229.713,
    "end": 231.857
  },
  {
    "id": "s09_1",
    "sourceId": "s09",
    "scene": "s8",
    "speaker": "سالم",
    "text": "وقفت اللي مجدوله من عندي",
    "start": 234.283,
    "end": 235.929
  },
  {
    "id": "s09_2",
    "sourceId": "s09",
    "scene": "s8",
    "speaker": "سالم",
    "text": "وبحط التصحيح قبل أي مقطع ثاني",
    "start": 235.929,
    "end": 238.262
  },
  {
    "id": "d13_1",
    "sourceId": "d13",
    "scene": "s9",
    "speaker": "دانا",
    "text": "ريم وينج",
    "start": 244.057,
    "end": 244.764
  },
  {
    "id": "d13_2",
    "sourceId": "d13",
    "scene": "s9",
    "speaker": "دانا",
    "text": "حسابج توه يقول إنج بخير",
    "start": 244.764,
    "end": 246.766
  },
  {
    "id": "d13_3",
    "sourceId": "d13",
    "scene": "s9",
    "speaker": "دانا",
    "text": "وداز لي موقع ويطلب أجي بروحي",
    "start": 246.787,
    "end": 248.885
  },
  {
    "id": "r04_1",
    "sourceId": "r04",
    "scene": "s9",
    "speaker": "ريم",
    "text": "لا تروحين",
    "start": 251.005,
    "end": 251.784
  },
  {
    "id": "r04_2",
    "sourceId": "r04",
    "scene": "s9",
    "speaker": "ريم",
    "text": "أنا أكلمج من تلفون البنت",
    "start": 251.853,
    "end": 253.808
  },
  {
    "id": "r04_3",
    "sourceId": "r04",
    "scene": "s9",
    "speaker": "ريم",
    "text": "تلفوني مو معاي من قبل ما ينتشر المقطع",
    "start": 253.876,
    "end": 256.821
  },
  {
    "id": "d14_1",
    "sourceId": "d14",
    "scene": "s9",
    "speaker": "دانا",
    "text": "يعني الرسالة والموقع اللي وصلوني مو منج",
    "start": 258.938,
    "end": 261.715
  },
  {
    "id": "d14_2",
    "sourceId": "d14",
    "scene": "s9",
    "speaker": "دانا",
    "text": "منو اللي قاعد يرد علي باسمج",
    "start": 261.715,
    "end": 263.389
  },
  {
    "id": "r05_1",
    "sourceId": "r05",
    "scene": "s9",
    "speaker": "ريم",
    "text": "ما أدري",
    "start": 265.502,
    "end": 266.02
  },
  {
    "id": "r05_2",
    "sourceId": "r05",
    "scene": "s9",
    "speaker": "ريم",
    "text": "بس اللي كتبها يعرف إنج بتصدقيني",
    "start": 266.02,
    "end": 268.326
  },
  {
    "id": "r05_3",
    "sourceId": "r05",
    "scene": "s9",
    "speaker": "ريم",
    "text": "اقفلي المحادثة وخليج معاي على الخط",
    "start": 268.326,
    "end": 270.658
  },
  {
    "id": "d15_1",
    "sourceId": "d15",
    "scene": "s10",
    "speaker": "دانا",
    "text": "في أحد يدق باب شقتنا",
    "start": 278.257,
    "end": 279.762
  },
  {
    "id": "d15_2",
    "sourceId": "d15",
    "scene": "s10",
    "speaker": "دانا",
    "text": "ثلاث دقات مثل اللي قلتيها بالمقطع",
    "start": 279.762,
    "end": 282.143
  },
  {
    "id": "r06_1",
    "sourceId": "r06",
    "scene": "s10",
