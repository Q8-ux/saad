# Text provider: openai (default), gemini, meta, groq, nvidia, openrouter, heretic.
# Heretic is opt-in only. Use your own authenticated TLS inference server for sensitive legal data. Secrets belong only on the server.
LEGAL_AI_PROVIDER=openai
# Optional, explicitly selected alternate after a rejected text request only.
LEGAL_AI_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
NVIDIA_API_KEY=
NVIDIA_MODEL=
OPENROUTER_API_KEY=
# A pinned model ending in :free is required.
OPENROUTER_MODEL=
# Heretic GGUF Q4_K_M runs on a separate inference server, not in this Node web service.
# Set only after privacy/legal review; keep LEGAL_AI_PROVIDER=openai for production until validated.
HERETIC_CHAT_COMPLETIONS_URL=
HERETIC_API_KEY=
HERETIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Audio and document uploads continue to use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SESSION_SECRET=replace-with-a-long-random-value
LEGAL_RESEARCH_API_TOKEN=replace-with-a-long-random-secret
INTERNAL_APP_PORT=3001
PORT=3000
DATA_DIR=./data
UPLOAD_DIR=./uploads
PRIVATE_CASE_UPLOAD_DIR=./private-case-files
PRIVATE_CASE_MAX_FILE_MB=25
PRIVATE_CASE_MAX_FILES=25
MOJ_AUTO_SYNC=true
MOJ_LAWS_URL=https://moj.gov.kw/AR/Pages/MojLaws.aspx
MOJ_OCR_ENABLED=true
MOJ_OCR_MAX_PAGES=1000
MOJ_REQUEST_DELAY_MS=800
MOJ_REQUEST_TIMEOUT_MS=120000
MOJ_MAX_PDF_MB=250
